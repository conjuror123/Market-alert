__pycache__/
*.pyc
.venv/
venv/
.env
.pytest_cache/
*.egg-info/
data/backtest_results.json
data/calibration_review/

# Fully derived Tremor outputs, rebuilt from the committed bars by the run that
# reads them - delivery reads the events table the same run just wrote. Git
# cannot delta parquet, so committing them would store every byte again on
# every run without a single new fact.
#
#   metrics/        - per-asset metrics (the move and the gap), python -m tremor.pipeline;
#                     kept between runs in the Actions cache.
#   jumps.parquet   - the events, python -m tremor.jumps, rescored whole every run.
data/tremor/metrics/
data/tremor/jumps.parquet

# The open months of the bar store, appended every hour. Kept between runs on a
# GitHub release (tools/hot_bars.sh), where replacing a file costs the
# repository nothing; a month enters git once, settled, as .csv.gz
# (tremor/bars.py).
data/tremor/bars/*/*.csv

# Outputs of detectors that no longer run on this branch. Nothing writes them;
# the rules stay so a working copy that still holds the files cannot commit them.
data/tremor/events/
data/tremor/residuals/
data/tremor/metrics_basket_hour.parquet
data/tremor/decision_log.parquet
data/tremor/saed_events.parquet
data/tremor/saed_events_archive.parquet
data/tremor/record_book.parquet
.claude/settings.local.json
